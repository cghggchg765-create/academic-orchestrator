{
  "version": "1.0",
  "updated": "2026-11-26",
  "note": "能力地图：只存角色、能力边界、输入输出、交接与依赖，不存子技能流程。路径统一指向 zcode 入口；豆包通过 Junction 引用同一入口。 ｜ 2.0.0 可移植化：path/entry 改用 $SKILLS_ROOT/<name>，多根运行时解析；已移除特定平台根（不再需要双根 Junction）。",
  "stage_order": [
    "V0",
    "V0e",
    "V1",
    "V2"
  ],
  "presets": [
    {
      "name": "academic_zh_defensive_plus_ai",
      "when": "中文论文/摘要/引言/结论/rebuttal 既有防御性叙事，又有 AI 味",
      "sequence": [
        {
          "stage": "V0",
          "role": "narrative"
        },
        {
          "stage": "V2",
          "role": "edit"
        }
      ],
      "note": "V0 只改叙事与主张范围；V2 只做表面最小编辑。需要先评分/诊断时，V1 只诊断，不改稿。"
    },
    {
      "name": "academic_en_defensive_plus_ai",
      "when": "英文论文/摘要/引言/结论/rebuttal 既有防御性叙事，又有 AI 味",
      "sequence": [
        {
          "stage": "V0e",
          "role": "narrative"
        },
        {
          "stage": "V1",
          "role": "rewrite"
        }
      ],
      "note": "V0e 只改叙事；V1 做英文表面去味，不改事实与限定。"
    },
    {
      "name": "diagnose_then_edit_zh",
      "when": "中文文本需要先知道哪里假、为什么假，再最小编辑",
      "sequence": [
        {
          "stage": "V1",
          "role": "diagnose"
        },
        {
          "stage": "V2",
          "role": "edit"
        }
      ],
      "note": "V1 只出诊断/评分/优先级；V2 执行编辑，两者不得同时改写。"
    },
    {
      "name": "general_zh_ai",
      "when": "中文非学术文本只要去 AI 味，且不需要评分/平台适配",
      "sequence": [
        {
          "stage": "V2",
          "role": "edit"
        }
      ],
      "note": "需要作者声音、平台适配、评分或体裁判断时改走 V1。"
    },
    {
      "name": "general_ai_signal",
      "when": "一般文本/社媒/英文文本需要 AI 味诊断、改写、评分或 prompt 防御",
      "sequence": [
        {
          "stage": "V1",
          "role": "diagnose"
        }
      ],
      "note": "V1 可诊断并改写；若同时需要中文最小编辑，V1 只诊断，V2 执行。"
    }
  ],
  "selection_policy": {
    "hard_constraints": [
      "language",
      "text_type",
      "task_mode",
      "integrity",
      "goal"
    ],
    "score_scale": {
      "3": "完全命中",
      "2": "可承接但需分工",
      "1": "兜底",
      "0": "不匹配或硬冲突"
    },
    "tie_break": [
      "hard_constraints",
      "language",
      "task_stage",
      "genre_audience",
      "edit_scope",
      "cost"
    ],
    "stars_usage": "not used as hard constraint; maturity only"
  },
  "skills": [
