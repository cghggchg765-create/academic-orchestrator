{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/spec/result.schema.json",
  "type": "object",
  "required": ["schema_version", "agent_id", "node_id", "run_id", "status", "artifacts", "checks", "feedback", "timestamps", "payload"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "agent_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "pattern": "^N[0-8]$"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["pending", "in_progress", "completed", "failed", "blocked", "review_pending", "repair_pending", "escalated"]},
    "review_verdict": {"type": ["string", "null"], "enum": ["PASS", "FAIL", "BLOCKED", null]},
    "decision_action": {"type": ["string", "null"]},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "sha256": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]}, "evidence": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "feedback": {"type": "array", "items": {"type": "object", "required": ["category", "message"], "properties": {"category": {"type": "string"}, "message": {"type": "string"}, "severity": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "timestamps": {"type": "object", "required": ["started_at", "finished_at"], "properties": {"started_at": {"type": "string"}, "finished_at": {"type": ["string", "null"]}}, "additionalProperties": true},
    "payload": {"type": "object"},
    "skills_read": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "scope_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "scope_key": {"type": ["string", "null"]},
    "scope_kind": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"]},
    "target_ref": {"type": ["string", "null"]},
    "output_scope": {"type": ["string", "null"]},
    "input_manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "base_artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "attempt": {"type": ["integer", "null"], "minimum": 1},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "merge_status": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
